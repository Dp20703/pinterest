    <div class="container">

        <% posts.forEach((post)=>{%>
            <div class="box">
                <a href="<%= process.env.BACKEND_URL || 'http://localhost:4000'%>/images/uploads/<%= post.imageUrl %>">
                    <img src="/images/uploads/<%= post.imageUrl %>" alt="image"></a>
                <div class="caption">
                    <%= post.postText %>
                </div>
            </div>
            <% })%>


                <div class="box">
                    <a href="https://gallery1.charleskdesigns.com/image/002.jpg">
                        <img src="https://gallery1.charleskdesigns.com/image/002.jpg" alt="image"></a>
                    <div class="caption">Lorem ipsum </div>
                </div>

                <div class="box">
                    <a href="https://gallery1.charleskdesigns.com/image/003.jpg">
                        <img src="https://gallery1.charleskdesigns.com/image/003.jpg" alt="image"></a>
                    <div class="caption">Lorem ipsum </div>
                </div>

                <!-- Random posts -->
                <% for(var i=19; i<=32; i++) {%>
                    <div class="box">
                        <a href="https://gallery1.charleskdesigns.com/image/0<%= i %>.jpg">
                            <img src="https://gallery1.charleskdesigns.com/image/0<%= i %>.jpg" alt="image"></a>
                        <div class="caption">Lorem ipsum </div>
                    </div>
                    <% } %>
    </div>

    <script src="https://code.jquery.com/jquery-3.3.1.js"></script>
    <script src="/js/feed.js"></script>
</body>

</html>